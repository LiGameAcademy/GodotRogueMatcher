[sub_resource type="Resource" id="event_condition"]
script = ExtResource("4")
event_type = &"piece_eliminated"

[sub_resource type="Resource" id="cause_condition"]
script = ExtResource("6")
allowed_causes = Array[StringName]([&"match", &"explosion", &"skill_clear", &"consume"])

[sub_resource type="Resource" id="conditions"]
script = ExtResource("5")
conditions = Array[ExtResource("7")]([SubResource("event_condition"), SubResource("cause_condition")])
operator = "AND"

[sub_resource type="Resource" id="trigger"]
script = ExtResource("3")
trigger_type = 1
conditions = Array[ExtResource("7")]([SubResource("conditions")])
max_triggers = 1
trigger_event = &"piece_eliminated"

[sub_resource type="Resource" id="effect"]
script = ExtResource("2")

[resource]
script = ExtResource("1")
