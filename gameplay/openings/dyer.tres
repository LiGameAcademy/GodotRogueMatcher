[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://gameplay/openings/opening_role.gd" id="role"]
[ext_resource type="Texture2D" path="res://assets/textures/roles/dyer.png" id="portrait"]
[ext_resource type="Script" path="res://gameplay/progression/skill_definition.gd" id="def"]
[ext_resource type="Resource" path="res://gameplay/progression/content/match_dye_echo.tres" id="match_dye_echo"]

[resource]
script = ExtResource("role")
id = &"dyer"
threshold = 450
portrait = ExtResource("portrait")
skills = Array[ExtResource("def")]([ExtResource("match_dye_echo")])
