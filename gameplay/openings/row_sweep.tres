[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://gameplay/openings/opening_role.gd" id="role"]
[ext_resource type="Texture2D" path="res://assets/textures/roles/row_sweep.png" id="portrait"]
[ext_resource type="Script" path="res://gameplay/progression/skill_definition.gd" id="def"]
[ext_resource type="Resource" path="res://gameplay/progression/content/line_row_drop.tres" id="line_row_drop"]

[resource]
script = ExtResource("role")
id = &"row_sweep"
threshold = 100
portrait = ExtResource("portrait")
skills = Array[ExtResource("def")]([ExtResource("line_row_drop")])
