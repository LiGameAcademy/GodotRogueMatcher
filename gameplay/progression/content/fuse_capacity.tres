[gd_resource type="Resource" script_class="SkillDefinition" load_steps=6 format=3]
[ext_resource type="Script" path="res://gameplay/progression/skill_definition.gd" id="1"]
[ext_resource type="Script" path="res://gameplay/progression/effects/install_upgrade_effect.gd" id="2"]
[ext_resource type="Script" path="res://gameplay/progression/skill_offer_traits.gd" id="offer_traits_script"]

[sub_resource type="Resource" id="effect"]
script = ExtResource("2")
upgrade = &"fuse_capacity"
[sub_resource type="Resource" id="offer_traits"]
script = ExtResource("offer_traits_script")
mechanisms = Array[StringName]([&"blast", &"fuse"])
affinity = Array[StringName]([&"blast", &"fuse"])
invests = Array[StringName]([&"blast", &"fuse"])
supplies = Array[StringName]([])
payoffs = Array[StringName]([])
needs = Array[StringName]([&"core_supply", &"fuse_unlocked"])
roles = Array[StringName]([&"enhancement"])
lifetime = "persistent"
once_per_run = false
upgradeable = true
repeatable = false
utility_pick = false

[resource]
script = ExtResource("1")
offer_traits = SubResource("offer_traits")
skill_id = &"fuse_capacity"
title = "双份引信"
description = "本局引信赋能目标上限每级+1（2→3→4），最多2级。不扩大装填、传播或布雷数量。"
short_description = "引信赋能目标数+1/级：2 → 3 → 4。\n不影响其他装填或传递。"
tags = Array[StringName]([&"exp", &"extra"])
choice_effect = SubResource("effect")
rarity = 0
maximum_level = 2
minimum_reward = 1
is_persistent = true
prerequisite = &""
