[resource]
script = ExtResource("1")
offer_traits = SubResource("offer_traits")
skill_id = &"composite_refill_color"
title = "留白调色"
description = "有序组合：先降低接下来3次实际普通补棋各1枚，再提高一种颜色的普通生成权重+2。先提交补棋修正，再读取更新后的权重状态。"
short_description = "有序：补棋−1（3次）→ 单色权重+2。"
levels = Array[ExtResource("2")]([SubResource("level_1")])
tags = Array[StringName]([&"generation", &"extra"])
