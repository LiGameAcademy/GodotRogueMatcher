[gd_resource type="Resource" script_class="SkillDefinition" load_steps=6 format=3]
[ext_resource type="Script" path="res://gameplay/progression/skill_definition.gd" id="1"]
[ext_resource type="Script" path="res://gameplay/progression/effects/install_dye_upgrade_effect.gd" id="2"]
[ext_resource type="Script" path="res://gameplay/progression/skill_offer_traits.gd" id="offer_traits_script"]

[sub_resource type="Resource" id="effect"]
script = ExtResource("2")
upgrade = &"match_dye_echo"
[sub_resource type="Resource" id="offer_traits"]
script = ExtResource("offer_traits_script")
mechanisms = Array[StringName]([&"dye"])
affinity = Array[StringName]([&"dye"])
invests = Array[StringName]([&"dye"])
supplies = Array[StringName]([&"dye"])
payoffs = Array[StringName]([])
needs = Array[StringName]([])
roles = Array[StringName]([&"supply"])
lifetime = "persistent"
once_per_run = true
upgradeable = false
repeatable = false
utility_pick = false

[resource]
script = ExtResource("1")
offer_traits = SubResource("offer_traits")
skill_id = &"match_dye_echo"
title = "染色接续"
description = "五连消除后，将相邻的1枚异色普通棋子染成消除色；每次行动最多1波。"
short_description = "五连后 → 染1枚邻近异色普通棋。\n染成消除色；每行动最多1波。"
tags = Array[StringName]([&"dye", &"match"])
choice_effect = SubResource("effect")
rarity = 0
maximum_level = 1
is_persistent = true
minimum_reward = 1
