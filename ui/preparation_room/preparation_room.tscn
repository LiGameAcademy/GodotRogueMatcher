[node name="PreparationRoom" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Garden" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
texture = ExtResource("garden")
expand_mode = 1
stretch_mode = 6
mouse_filter = 2

[node name="Shade" type="ColorRect" parent="."]
