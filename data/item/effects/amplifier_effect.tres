[gd_resource type="Resource" script_class="ItemEffectConfig" load_steps=4 format=3 uid="uid://amplifier_effect"]

[ext_resource type="Script" path="res://scripts/gameplay/item_effect_config.gd" id="1_config"]
[ext_resource type="Script" path="res://scripts/gameplay/conditions/condition_timing.gd" id="2_timing"]
[ext_resource type="Script" path="res://scripts/gameplay/conditions/condition_in_range.gd" id="3_range"]

[sub_resource type="ConditionTiming" id="ConditionTiming_1"]
condition_id = "timing"
timing = 3

[sub_resource type="ConditionInRange" id="ConditionInRange_1"]
