; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Matcher"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

GameManager="*res://scripts/global/game_manager.gd"
MatchSystem="*res://scripts/global/match_system.gd"
SpawnManager="*res://scripts/global/spawn_manager.gd"
PathfindingManager="*res://scripts/global/pathfinding_manager.gd"

[display]

window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=3
anti_aliasing/quality/use_taa=true
